---
import '../styles/global.css';

const title = 'Сайт и мобильное приложение доставки для ресторанной сети — Delivest';
const description = 'Запустите доставку под брендом вашей ресторанной сети. Сайт, приложение, меню и зоны доставки для каждого филиала. Базовый тариф — 5 000 ₽/мес, Pro — 8 000 ₽/мес.';
const site = Astro.site!.href;
const cover = new URL('/brand/share-restaurant.jpg', site).href;
const coverAlt = 'Delivest — сайт и приложение доставки для ресторанных сетей. Экраны заказа на компьютере и телефоне.';
const organization = { '@type': 'Organization', '@id': site + '#organization', name: 'Delivest', url: site };
const structuredData = { '@context': 'https://schema.org', '@graph': [
  organization,
  { '@type': 'WebSite', name: 'Delivest', url: site, inLanguage: 'ru', publisher: { '@id': organization['@id'] } },
] };
---
<!doctype html>
<html lang="ru" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={site}>
  <meta property="og:type" content="website">
  <meta property="og:locale" content="ru_RU">
  <meta property="og:site_name" content="Delivest">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={cover}>
  <meta property="og:url" content={site}>
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={coverAlt}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={cover}>
  <meta name="twitter:image:alt" content={coverAlt}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <meta name="theme-color" content="#FFF8F0">
  <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png">
  <link rel="preload" as="image" href="/franchise/hero.webp" fetchpriority="high">
  <script is:inline>
    (() => {
      const root = document.documentElement;
      root.classList.add('loading-active');
      let deadline;
      let done = false;
      const finish = () => {
        if (done) return;
        done = true;
        clearTimeout(deadline);
        root.classList.remove('loading-active');
        root.classList.add('loading-done');
        window.dispatchEvent(new Event('landing:loaded'));
      };
      window.addEventListener('landing:ready', finish, { once: true });
      // Keep the landing accessible if a critical request stalls.
      deadline = setTimeout(finish, 8000);
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700&family=Lora:ital,wght@1,500&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
</head>
<body id="top">
  <div class="page-loader" aria-hidden="true">
    <img src="/brand/loader.svg" alt="" width="88" height="88">
  </div>
  <slot />
  <script>import '../lib/landing-browser';</script>
  <script>
    const heroImage = new Image();
    heroImage.src = '/franchise/hero.webp';
    const introImages = document.querySelectorAll<HTMLImageElement>('.intro-visual img[loading="eager"]');
    const firstImages = [heroImage, ...introImages];
    Promise.allSettled(firstImages.map(image => image.decode())).then(() => {
      window.dispatchEvent(new Event('landing:ready'));
    });

    const imageSafety = new IntersectionObserver(entries => entries.forEach(entry => {
      if (entry.isIntersecting) {
        setTimeout(() => entry.target.dispatchEvent(new Event('image:safety')), 2000);
        imageSafety.unobserve(entry.target);
      }
    }), { rootMargin: '300px' });
    document.querySelectorAll<HTMLImageElement>('main img[loading="lazy"]').forEach(img => {
      if (img.matches('.brand-image, .light, .dark') || img.closest('.brand-slider')) return;
      if (img.complete) return;
      img.classList.add('image-pending');
      const reveal = () => {
        img.classList.remove('image-pending');
        img.classList.add('image-ready');
      };
      img.addEventListener('load', reveal, { once: true });
      img.addEventListener('error', reveal, { once: true });
      img.addEventListener('image:safety', reveal, { once: true });
      imageSafety.observe(img);
    });

    const io = new IntersectionObserver(entries => entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }), { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
    document.documentElement.classList.add('reveal-ready');
  </script>
</body>
</html>
