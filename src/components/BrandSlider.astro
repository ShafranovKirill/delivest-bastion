---
const brands = [
  ['brick-burger', 'Brick Burger'],
  ['forno27', 'Forno27'],
  ['nori', 'Nori'],
  ['kroshka', 'Крошка'],
  ['black-cup', 'Black Cup'],
  ['lapsha', 'Лапша'],
  ['green-fork', 'Green Fork'],
  ['teply-dvor', 'Тёплый двор'],
  ['taco-loco', 'Taco Loco'],
  ['sol', 'Соль'],
  ['wave-poke', 'Wave Poke'],
  ['mishka-grill', 'Мишка Гриль'],
];
---

<section class="brand-slider" aria-labelledby="brand-slider-title">
  <div class="brand-slider-head">
    <h2 id="brand-slider-title">С нами сотрудничают 30+ ресторанов</h2>
  </div>
  <div class="brand-frame">
    <div class="brand-viewport" tabindex="0" aria-label="Примеры брендов ресторанов, прокрутка по горизонтали">
      <div class="brand-track">
        <ul class="brand-group">
          {brands.map(([file, name]) => <li><img src={`/franchise/brands/${file}.webp`} alt={name} width="480" height="240" decoding="async" /></li>)}
        </ul>
        <div class="brand-group clone" aria-hidden="true">
          {brands.map(([file]) => <div class="brand-item"><img src={`/franchise/brands/${file}.webp`} alt="" width="480" height="240" decoding="async" /></div>)}
        </div>
      </div>
    </div>
  </div>
  <p class="brand-caption">Примеры оформления брендов</p>
  <div class="facts-grid" aria-label="Delivest в фактах">
    <article class="fact">
      <strong class="fact-value">2 месяца</strong>
      <h3>Бесплатный старт</h3>
      <p>Проверьте Delivest в работе до оплаты подписки.</p>
    </article>
    <article class="fact">
      <strong class="fact-value">от 3&nbsp;000&nbsp;₽</strong>
      <h3>Собственный сайт доставки</h3>
      <p>Базовый тариф в месяц после бесплатного периода. Цена зависит от оборота франшизы.</p>
    </article>
    <article class="fact">
      <strong class="fact-value">Одна система</strong>
      <h3>Для всей сети</h3>
      <p>Меню, заказы и условия работы филиалов в одном месте.</p>
    </article>
    <article class="fact">
      <strong class="fact-value">AI-помощь</strong>
      <h3>В обоих тарифах</h3>
      <p>Подготовка контента и маркетинговое сопровождение нашей команды.</p>
    </article>
  </div>
</section>

<style>
  .brand-slider { padding: 32px 0 52px; overflow: hidden; background: #f4ece6; color: #321418; }
  .brand-slider-head { max-width: 1120px; width: calc(100% - 40px); margin: 0 auto 14px; text-align: center; }
  h2 { margin: 0; font: 700 clamp(18px, 2vw, 24px)/1.25 Onest, sans-serif; letter-spacing: -.02em; }
  .brand-frame { position: relative; max-width: 1120px; width: calc(100% - 40px); margin: 0 auto; }
  .brand-frame::before, .brand-frame::after { content: ''; position: absolute; inset-block: 0; z-index: 1; width: 64px; pointer-events: none; backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px); }
  .brand-frame::before { left: 0; background: linear-gradient(90deg, #f4ece6, transparent); mask-image: linear-gradient(90deg, #000, transparent); -webkit-mask-image: linear-gradient(90deg, #000, transparent); }
  .brand-frame::after { right: 0; background: linear-gradient(270deg, #f4ece6, transparent); mask-image: linear-gradient(270deg, #000, transparent); -webkit-mask-image: linear-gradient(270deg, #000, transparent); }
  .brand-viewport { overflow: hidden; outline-offset: -3px; }
  .brand-track { display: flex; width: max-content; animation: glide 36s linear infinite; }
  .brand-group { display: flex; flex: none; gap: 0; width: max-content; margin: 0; padding: 0; list-style: none; }
  .brand-group li, .brand-item { display: grid; place-items: center; flex: 0 0 160px; width: 160px; height: 110px; padding: 4px 0; }
  img { display: block; width: 100%; height: 100%; object-fit: contain; filter: grayscale(1); opacity: .55; }
  .brand-slider:hover .brand-track { animation-play-state: paused; }
  .brand-slider:focus-within .brand-viewport { overflow-x: auto; }
  .brand-slider:focus-within .brand-track { animation: none; transform: none; }
  .brand-slider:focus-within .clone { display: none; }
  .brand-caption { max-width: 1120px; width: calc(100% - 40px); margin: 0 auto 30px; color: #806c68; font-size: 12px; text-align: center; }
  .facts-grid { max-width: 1120px; width: calc(100% - 40px); margin: 0 auto; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .fact { min-width: 0; min-height: 230px; padding: 24px; border-radius: 8px; background: #fffaf5; }
  .fact:nth-child(2) { background: #48010c; color: #fff6f4; }
  .fact:nth-child(3) { background: #e8d7cc; }
  .fact:nth-child(4) { background: #efc07a; }
  .fact-value { display: block; margin-bottom: 24px; font-size: clamp(25px, 2.35vw, 33px); line-height: 1.05; letter-spacing: -.045em; }
  .fact h3 { margin: 0 0 8px; font-size: 17px; line-height: 1.25; letter-spacing: -.02em; }
  .fact p { margin: 0; font-size: 14px; line-height: 1.45; }
  @media (max-width: 1050px) { .facts-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .fact { min-height: 200px; } }
  @keyframes glide { to { transform: translateX(-50%); } }
  @media (max-width: 650px) {
    .brand-slider { padding-block: 26px 42px; }
    .brand-slider-head, .brand-frame, .brand-caption, .facts-grid { width: calc(100% - 32px); }
    .brand-frame::before, .brand-frame::after { width: 36px; }
    .brand-group li, .brand-item { flex-basis: 125px; width: 125px; height: 92px; }
    .fact { padding: 20px; }
    .fact-value { font-size: 26px; }
  }
  @media (max-width: 360px) { .facts-grid { grid-template-columns: 1fr; } .fact { min-height: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .brand-viewport { overflow-x: auto; }
    .brand-track { animation: none; }
    .clone { display: none; }
  }
</style>

<script>
  const viewport = document.querySelector<HTMLElement>('.brand-slider .brand-viewport');
  viewport?.addEventListener('blur', () => {
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) viewport.scrollLeft = 0;
  });
</script>
