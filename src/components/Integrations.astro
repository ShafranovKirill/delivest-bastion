---
import logo from '../assets/brand/logo-horizontal.svg?url';
const integrations = [
  { side: 'left', row: 1, category: 'POS-системы', title: 'iiko · r_keeper · Frontpad', text: 'Заказы поступают в привычную систему ресторана.' },
  { side: 'right', row: 1, category: 'Оплата на сайте', title: 'ЮKassa', text: 'Гость оплачивает заказ картой или через СБП.' },
  { side: 'left', row: 2, category: 'Онлайн-касса', title: 'АТОЛ Онлайн', text: 'Оформляйте электронные чеки для гостей.' },
  { side: 'right', row: 2, category: 'Заказы и курьеры', title: 'Сервисы Яндекса', text: 'Принимайте заказы из Яндекс Еды и Деливери. Яндекс Доставка поможет найти курьера.' },
];
---
<section id="integrations" aria-labelledby="integrations-title">
  <div class="wrap">
    <div class="head">
      <span class="kicker">Интеграции</span>
      <h2 id="integrations-title">Ваша касса, оплата <em>и доставка.</em></h2>
      <p>Подключите к Delivest сервисы, с которыми уже работают ваши точки.</p>
    </div>
    <div class="integration-map">
      <div class="platform-card"><img src={logo} alt="Delivest" /></div>
      {integrations.map(item => (
        <>
          <article class:list={['service-card', `service-${item.side}`]} style={`--row:${item.row}`}>
            <div class="service-label">{item.category}</div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
          <div class:list={['service-link', `link-${item.side}`]} style={`--row:${item.row}`} aria-hidden="true"><span></span></div>
        </>
      ))}
    </div>
  </div>
</section>
<style>
  .integration-map {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 36px 190px 36px minmax(0, 1fr);
    grid-template-rows: repeat(2, 1fr);
    row-gap: 20px;
  }
  .platform-card {
    grid-column: 3;
    grid-row: 1 / 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 28px 16px;
    border-radius: 28px;
    background: var(--brand);
    color: #fff6f4;
    text-align: center;
  }
  .service-card {
    grid-row: var(--row);
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--card);
    min-width: 0;
  }
  .service-left { grid-column: 1; }
  .service-right { grid-column: 5; }
  .service-label { display: flex; justify-content: space-between; gap: 16px; font-size: 11px; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); margin-bottom: 24px; }
  .service-label > span:last-child { color: var(--accent); }
  .service-card h3 { font-size: clamp(20px, 2vw, 25px); line-height: 1.25; }
  .service-card p { font-size: 15px; color: var(--ink-2); margin: 12px 0 0; }
  /* Every connector lives in its own grid cell, outside all cards. */
  .service-link { grid-row: var(--row); display: flex; align-items: center; }
  .link-left { grid-column: 2; }
  .link-right { grid-column: 4; }
  .service-link span { display: block; width: 100%; height: 1px; background: var(--accent); opacity: .4; }

  .platform-card img { width: min(100%, 145px); height: auto; filter: brightness(0) invert(1); }
  #integrations { background: #fff9f4; padding-block: clamp(60px, 8vw, 112px); color: #310812; }
  .head { max-width: 760px; margin-bottom: 36px; }
  .head h2 { font-size: clamp(36px, 4.8vw, 68px); }
  @media(max-width: 700px) {
    .integration-map { grid-template-columns: repeat(2,minmax(0,1fr)); grid-template-rows: auto auto auto; gap: 12px; }
    .service-card { grid-row: auto; padding: 15px 12px; border-radius: 14px; }
    .service-left { grid-column: 1; }
    .service-right { grid-column: 2; }
    .service-card:nth-of-type(n+3) { grid-row: 3; }
    .service-card h3 { font-size: 16px; overflow-wrap: anywhere; }
    .service-label { margin-bottom: 8px; font-size: 11px; text-transform: none; letter-spacing: 0; }
    .service-card p { font-size: 13px; line-height: 1.4; }
    .platform-card { grid-column: 1 / -1; grid-row: 2; justify-self: center; width: 132px; padding: 18px; border-radius: 18px; position: relative; }
    .platform-card::before, .platform-card::after { content: ''; position: absolute; width: 1px; height: 12px; background: #ae747b; left: 50%; }
    .platform-card::before { bottom: 100%; }
    .platform-card::after { top: 100%; }
    .service-link { display: none; }
  }
</style>
