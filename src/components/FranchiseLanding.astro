---
import logo from "../assets/brand/logo-horizontal.svg?raw";
import Faq from "./Faq.astro";
import Pricing from "./Pricing.astro";
import Integrations from "./Integrations.astro";
import BrandSlider from "./BrandSlider.astro";
import ProductPresentation from "./ProductPresentation.astro";
const demo = "https://delivest-client.shafranov.tech/kovrov";
const mark = logo
  .replaceAll(' fill="#48010c"', "")
  .replace(
    ' width="1518" height="352"',
    ' class="logo-full" role="img" aria-label="Delivest"',
  );
---

<div class="franchise" data-guest-theme="light">
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <h1 id="hero-title">
          Сайт и мобильное приложение <em>для вашей сети.</em>
        </h1>
        <div class="actions">
          <button class="pill gold" type="button" data-lead="pricing">
            Обсудить подключение <span>↗</span>
          </button>
          <a class="pill hero-demo" href={demo} target="_blank" rel="noopener">
            Посмотреть демо-сайт <span aria-hidden="true">↗</span>
          </a>
        </div>
        <p class="trial-note">Первые 2 месяца подписки бесплатно — с запуска сайта.</p>
      </div>
    </div>
  </section>

  <section class="product-overview intro" id="app" aria-label="Сайт ресторана на компьютере и телефоне">
    <div class="wrap">
        <div class="intro-visual">
          <div class="desktop shot">
            <img
              class="light"
              src="/franchise/desktop-light.webp"
              alt="Сайт ресторана на компьютере, светлая тема"
              width="1049"
              height="651"
              loading="lazy"
            />
            <img
              class="dark"
              src="/franchise/desktop-dark.webp"
              alt="Сайт ресторана на компьютере, тёмная тема"
              width="1049"
              height="651"
              loading="lazy"
            />
          </div>
          <div class="intro-phone shot">
            <img
              src="/franchise/mobile-menu.webp"
              alt="Мобильное меню ресторана с акциями, категориями и ценами на бургеры"
              width="369"
              height="806"
              loading="lazy"
            />
          </div>
        </div>
    </div>
  </section>

  <BrandSlider />

  <ProductPresentation />

  <section
    class="photo-split launch"
    id="launch"
    aria-labelledby="launch-title"
  >
    <div class="photo">
      <img
        src="/franchise/launch.webp"
        alt="Команда ресторана готовится к работе"
        width="1536"
        height="1024"
        loading="lazy"
      />
    </div>
    <div class="photo-copy">
      <span class="eyebrow pale">Для сети филиалов</span>
      <h2 id="launch-title">
        Одна сеть.<br /><em>Свои условия у каждой точки.</em>
      </h2>
      <p>
        Все филиалы — в одной системе. Для каждой точки — своё меню, цены,
        график и зоны доставки.
      </p>
      <p class="launch-support">Настройка и сопровождение каждой точки — в обоих тарифах.</p>
      <button class="pill cream" type="button" data-lead="pricing">
        Обсудить подключение <span>↗</span>
      </button>
    </div>
  </section>

  <section class="section onboarding" aria-labelledby="onboarding-title">
    <div class="wrap">
      <div class="section-top"><span class="eyebrow">В каждом тарифе</span></div>
      <div class="onboarding-heading">
        <div class="onboarding-intro">
          <h2 id="onboarding-title">Запуск и сопровождение<br /><em>берём на себя.</em></h2>
          <p>В обоих тарифах: настройка сайта, меню и поддерживаемой CRM. После запуска — помощь с маркетингом и контентом.</p>
        </div>
        <img class="onboarding-photo" src="/franchise/onboarding-workspace.webp" alt="Ноутбук с меню доставки, телефон, блюдо и упаковка на столе кафе" width="1536" height="1024" loading="lazy" />
      </div>
      <div class="onboarding-grid">
        <article>
          <span class="onboarding-number">01 · Запуск</span>
          <h3>Сайт и меню</h3>
          <p>Добавим блюда, фото и цены. Подготовим точки к запуску.</p>
        </article>
        <article>
          <span class="onboarding-number">02 · Запуск</span>
          <h3>CRM и заказы</h3>
          <p>Подключим поддерживаемую CRM и проверим приём заказов.</p>
        </article>
        <article>
          <span class="onboarding-number">03 · Поддержка</span>
          <h3>Маркетинг</h3>
          <p>Подготовим акции и баннеры, чтобы гости возвращались.</p>
        </article>
        <article>
          <span class="onboarding-number">04 · Поддержка</span>
          <h3>AI-помощь</h3>
          <p>Поможем с фото блюд, описаниями и контентом с помощью AI.</p>
        </article>
      </div>
      <p class="onboarding-note">План работ согласуем при подключении, материалы — до публикации.</p>
    </div>
  </section>

  <section
    class="section operations"
    id="operations"
    aria-labelledby="operations-title"
  >
    <div class="wrap">
      <div class="section-top">
        <span class="eyebrow">После нажатия «Заказать»</span>
      </div>
      <div class="section-heading">
        <h2 id="operations-title">От оформления<br /><em>до выдачи.</em></h2>
        <p>
          Пока гость ждёт заказ, команда видит, что происходит на каждом этапе.
          Delivest связывает оформление, кухню и доставку.
        </p>
      </div>
      <div class="card-grid">
        <article class="process-card">
          <span class="eyebrow">Оформление заказа</span>
          <h3>Заказ без лишних шагов.</h3>
          <p>
            Гость выбирает способ получения и видит детали до подтверждения.
          </p>
          <button
            class="shot checkout-shot"
            type="button"
            data-enlarge="checkout"
            aria-label="Увеличить экран оформления заказа"
          >
            <img
              class="light"
              src="/franchise/checkout-light.webp"
              alt="Экран оформления заказа"
              width="374"
              height="718"
              loading="lazy"
            />
            <img
              class="dark"
              src="/franchise/checkout-dark.webp"
              alt="Экран оформления заказа в тёмной теме"
              width="374"
              height="718"
              loading="lazy"
            />
          </button>
        </article>
        <article class="process-card kitchen-card">
          <span class="eyebrow">Кухня и самовывоз</span>
          <h3>Команда видит задачу.</h3>
          <p>
            Новые заказы и их статус доступны сотрудникам. Повар отмечает, когда
            заказ можно выдавать.
          </p>
          <button
            class="shot kitchen-shot"
            type="button"
            data-enlarge="kitchen"
            aria-label="Увеличить экран кухни"
          >
            <img
              class="light"
              src="/franchise/kitchen-light.webp"
              alt="Экран заказов кухни"
              width="556"
              height="317"
              loading="lazy"
            />
            <img
              class="dark"
              src="/franchise/kitchen-dark.webp"
              alt="Экран заказов кухни в тёмной теме"
              width="556"
              height="317"
              loading="lazy"
            />
          </button>
        </article>
      </div>
    </div>
  </section>

  <section class="photo-split delivery" aria-labelledby="delivery-title">
    <div class="photo">
      <img
        src="/franchise/delivery.webp"
        alt="Сотрудник передаёт коробки курьеру"
        width="1536"
        height="1024"
        loading="lazy"
      />
    </div>
    <div class="photo-copy">
      <span class="eyebrow pale">Доставка — продолжение впечатления</span>
      <h2 id="delivery-title">
        До двери.<br />
        <em>В вашем ритме.</em>
      </h2>
      <p>
        Заказы, кухня и курьеры работают в общем процессе. Гость получает
        любимое блюдо, а вы сохраняете контроль над собственным каналом
        доставки.
      </p>
    </div>
  </section>

  <Integrations />

  <section class="section growth" id="growth" aria-labelledby="growth-title">
    <div class="wrap">
      <div class="section-top">
        <span class="eyebrow">Повторные заказы</span>
      </div>
      <div class="section-heading">
        <h2 id="growth-title">
          Первый заказ —<br />
          <em>начало истории.</em>
        </h2>
        <p>
          Бонусные звёзды, промокоды и подарки дают повод вернуться. История
          заказов и статистика помогают увидеть, что работает, и выбрать
          следующее предложение.
        </p>
      </div>
      <div class="growth-grid">
        <article class="growth-card">
          <span class="eyebrow">Для гостя</span>
          <h3>Повторить прошлый заказ.</h3>
          <p>Предложения, бонусы и прошлые заказы остаются под рукой.</p>
          <button
            class="shot orders-shot"
            type="button"
            data-enlarge="orders"
            aria-label="Увеличить экран заказов гостя"
          >
            <img
              class="light"
              src="/franchise/orders-light.webp"
              alt="История заказов гостя"
              width="329"
              height="684"
              loading="lazy"
            />
            <img
              class="dark"
              src="/franchise/orders-dark.webp"
              alt="История заказов гостя в тёмной теме"
              width="329"
              height="684"
              loading="lazy"
            />
          </button>
        </article>
        <article class="growth-card analytics">
          <span class="eyebrow">Для бизнеса</span>
          <h3>Как прошла неделя в филиале?</h3>
          <p>
            Выручка, количество заказов и средний чек за выбранный период.
            График показывает, в какие часы у точки больше гостей.
          </p>
          <button
            class="shot stats-shot"
            type="button"
            data-enlarge="stats"
            aria-label="Увеличить экран статистики"
          >
            <img
              src="/franchise/stats-light.webp"
              alt="Панель статистики заказов"
              width="1560"
              height="824"
              loading="lazy"
            />
          </button>
        </article>
      </div>
    </div>
  </section>

  <Pricing />

  <Faq />

  <section class="closing" id="contacts" aria-labelledby="closing-title">
    <div class="closing-photo">
      <img
        src="/franchise/dinner.webp"
        alt="Пицца из доставки на домашнем столе"
        width="1122"
        height="1402"
        loading="lazy"
      />
    </div>
    <div class="closing-copy">
      <div class="closing-top">
        <span class="eyebrow pale">Давайте знакомиться</span>
        <span class="flourish" aria-hidden="true"> ✳ </span>
      </div>
      <h2 id="closing-title">Покажем Delivest<br /><em>для вашей сети.</em></h2>
      <p>
        Покажем Delivest в деле, обсудим ваш формат, точки и нужные подключения.
        Решение о запуске — после знакомства с продуктом.
      </p>
      <p class="closing-trial">Первые 2 месяца подписки бесплатно — с запуска сайта.</p>
      <div class="actions">
        <button class="pill gold" type="button" data-lead="pricing">
          Обсудить подключение <span>↗</span>
        </button>
        <a class="under pale-link" href={demo} target="_blank" rel="noopener">
          Сайт глазами гостя ↗
        </a>
      </div>
      <div class="contact-links">
        <a href="tel:+79255355278">+7 925 535-52-78</a>
        <a href="https://t.me/shafranov_ex" target="_blank" rel="noopener">
          Telegram ↗
        </a>
        <a href="https://vk.ru/shafranov_kirill" target="_blank" rel="noopener">
          ВКонтакте ↗
        </a>
      </div>
    </div>
  </section>

  <footer>
    <div class="wrap">
      <span class="footer-logo" set:html={mark} />
      <span> © 2026 Delivest </span>
      <a href="#top">Наверх ↑</a>
    </div>
  </footer>
  <dialog class="image-dialog" aria-label="Увеличенный экран Delivest">
    <button class="image-close" type="button" aria-label="Закрыть"> × </button>
    <img alt="" />
  </dialog>
</div>

<script>
  const story = document.querySelector<HTMLElement>('.franchise');
  const presentation = document.querySelector<HTMLElement>('#presentation');
  const facts = document.querySelector<HTMLElement>('.facts-grid');
  const onboarding = document.querySelector<HTMLElement>('.onboarding');
  const onboardingGrid = onboarding?.querySelector<HTMLElement>('.onboarding-grid');
  if (onboardingGrid && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    onboardingGrid.classList.add('assemble-ready');
    const cardsObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-assembled');
        cardsObserver.unobserve(entry.target);
      });
    }, { threshold: .16, rootMargin: '0px 0px -40px 0px' });
    onboardingGrid.querySelectorAll('article').forEach((card) => cardsObserver.observe(card));
  }
  if (story && presentation && facts && onboarding) {
    const smooth = (value: number) => { const t = Math.max(0, Math.min(1, value)); return t * t * (3 - 2 * t); };
    const mix = (from: number[], to: number[], amount: number) => `rgb(${from.map((v, i) => Math.round(v + (to[i] - v) * amount)).join(' ')})`;
    const syncStoryBackground = () => {
      const focus = innerHeight;
      const start = facts.getBoundingClientRect().top;
      const end = presentation.getBoundingClientRect().top;
      const darken = smooth((focus * .78 - start) / Math.max(1, end - start + focus * .38));
      const lighten = smooth((focus * .85 - onboarding.getBoundingClientRect().top) / (focus * .6));
      const amount = darken * (1 - lighten);
      story.style.setProperty('--story-bg', mix([245,238,232], [16,11,12], amount));
      story.style.setProperty('--story-text', mix([36,5,11], [255,250,245], amount));
      story.style.setProperty('--story-muted', mix([101,76,75], [185,170,173], amount));
      story.style.setProperty('--story-idle', mix([125,99,102], [137,126,129], amount));
    };
    let scheduled = false;
    const scheduleStoryBackground = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(() => { syncStoryBackground(); scheduled = false; });
    };
    window.addEventListener('scroll', scheduleStoryBackground, {passive:true});
    window.addEventListener('resize', scheduleStoryBackground);
    window.addEventListener('pageshow', scheduleStoryBackground);
    new ResizeObserver(scheduleStoryBackground).observe(story);
    document.fonts.ready.then(scheduleStoryBackground);
    syncStoryBackground();
  }

  const guestStage = document.querySelector<HTMLElement>(".guest-stage");
  const franchise = document.querySelector<HTMLElement>(".franchise");
  const guestButtons = document.querySelectorAll<HTMLButtonElement>(
    "button[data-guest-theme]",
  );
  guestButtons.forEach((button) =>
    button.addEventListener("click", () => {
      if (guestStage)
        guestStage.dataset.screenTheme = button.dataset.guestTheme;
      if (franchise) franchise.dataset.guestTheme = button.dataset.guestTheme;
      guestButtons.forEach((item) =>
        item.setAttribute("aria-pressed", String(item === button)),
      );
    }),
  );
  const dialog = document.querySelector<HTMLDialogElement>(".image-dialog");
  const dialogImage = dialog?.querySelector("img");
  const labels: Record<string, string> = {
    desktop: "Сайт гостя",
    "mobile-menu": "Меню на телефоне",
    product: "Карточка блюда",
    checkout: "Оформление заказа",
    kitchen: "Экран кухни",
    orders: "История заказов",
    stats: "Статистика заказов",
  };
  document
    .querySelectorAll<HTMLButtonElement>("[data-enlarge]")
    .forEach((button) =>
      button.addEventListener("click", () => {
        if (!dialog || !dialogImage) return;
        const name = button.dataset.enlarge!;
        const image = Array.from(button.querySelectorAll("img")).find(
          (item) => item.getClientRects().length > 0,
        );
        if (!image) return;
        dialogImage.src = image.currentSrc || image.src;
        dialogImage.alt = labels[name];
        dialog.showModal();
      }),
    );
  dialog
    ?.querySelector(".image-close")
    ?.addEventListener("click", () => dialog.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  const flourish = document.querySelector(".flourish");
  if (flourish && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const video = document.createElement("video");
    video.src = "/franchise/logo.webm";
    video.muted = true;
    video.playsInline = true;
    video.preload = "none";
    video.setAttribute("aria-hidden", "true");
    video.className = "closing-video";
    flourish.replaceWith(video);
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          video.play().catch(() => {});
          observer.disconnect();
        }
      },
      { threshold: 0.45 },
    );
    observer.observe(video);
  }
</script>

<style>
  .franchise {
    overflow-x: clip;
    --cream: #f5eee8;
    --wine: #48010c;
    --deep: #24050b;
    --white: #fffaf5;
    background: var(--cream);
    color: var(--deep);
  }
  .franchise :global(.wrap) {
    max-width: 1360px;
    padding-inline: clamp(20px, 5vw, 80px);
  }
  .franchise section {
    padding: 0;
  }
  .eyebrow {
    display: inline-block;
    color: #8e4851;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.4;
  }
  .eyebrow.pale {
    color: #f2c3b9;
  }
  .franchise h1,
  .franchise h2,
  .franchise h3 {
    letter-spacing: -0.055em;
  }
  .franchise h2 {
    font-size: clamp(40px, 5.2vw, 76px);
    line-height: 1.04;
    margin: 16px 0 26px;
    color: inherit;
  }
  .franchise h2 em,
  .franchise h1 em {
    color: #9e1c36;
  }
  .franchise p {
    line-height: 1.62;
  }
  .section {
    padding: clamp(80px, 10vw, 138px) 0 !important;
  }
  .section-top {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: baseline;
    padding-bottom: 20px;
    border-bottom: 1px solid #b9a8a2;
  }
  .section-top > span:last-child {
    color: #806c68;
    font-size: 13px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 34px;
    min-height: 56px;
    padding: 14px 22px;
    border-radius: 4px;
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    font:
      700 15px/1.3 Onest,
      sans-serif;
    transition:
      transform 0.2s,
      background 0.2s;
  }
  .pill:hover {
    transform: translateY(-3px);
  }
  .pill span {
    font-size: 20px;
    font-weight: 400;
    line-height: 1;
  }
  .pill.gold {
    color: #28080d;
    background: #efc07a;
  }
  .pill.gold:hover {
    background: #ffe0a0;
  }
  .pill.cream {
    background: var(--cream);
    color: var(--wine);
  }
  .under {
    display: inline-flex;
    gap: 15px;
    align-items: center;
    border: 0;
    border-bottom: 1px solid currentColor;
    padding: 0 0 8px;
    background: transparent;
    color: var(--wine);
    cursor: pointer;
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
  }
  .under.pale-link {
    color: var(--white);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
  }
  .hero {
    min-height: 0;
    position: relative;
    display: flex;
    color: var(--white);
    background: #321418 url("/franchise/hero.webp") center/cover no-repeat;
  }
  .hero:before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, #170408e0 0%, #1e060aaa 35%, #1e060a2a 73%),
      linear-gradient(0deg, #19050980, transparent 28%);
  }
  .hero::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    height: clamp(56px, 7vw, 96px);
    background: linear-gradient(to bottom, #f5eee800 0%, #f5eee814 20%, #f5eee84d 42%, #f5eee899 64%, #f5eee8db 83%, var(--cream) 100%);
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: clamp(32px, 5vw, 72px);
    padding-bottom: calc(clamp(56px, 7vw, 96px) + 72px);
  }
  .hero-copy {
    max-width: 840px;
  }
  .hero .actions { display:grid; grid-template-columns:repeat(2,minmax(0,280px)); gap:12px; }
  .hero .actions .pill { width:100%; height:56px; gap:16px; }
  .hero-demo { background:#fffaf510; border-color:#fffaf580; color:var(--white); }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .hero .pill { transform: none; }
    .hero .pill span { transition: transform .22s var(--ease); }
    .hero .pill:hover span { transform: translate(2px, -2px); }
  }
  .hero-demo:hover { background:#fffaf526; }

  .hero h1 {
